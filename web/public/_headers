# Cache WASM files aggressively (they have hashed names)
/*.wasm
  Cache-Control: public, max-age=31536000, immutable

# Don't cache HTML (always fetch latest)
/index.html
  Cache-Control: no-cache

# Cache JS/CSS with hashes for 1 year
/*.js
  Cache-Control: public, max-age=31536000, immutable
/*.css
  Cache-Control: public, max-age=31536000, immutable